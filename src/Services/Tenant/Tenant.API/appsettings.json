{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Tenant.API"
    }
  },
  "AllowedHosts": "*",
  "Tenancy": {
    "PublicTenantId": "00000000-0000-0000-0000-000000000001",
    "PublicTenantName": "Public",
    "PublicTenantSlug": "public"
  }
}
