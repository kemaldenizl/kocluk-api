{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Notification.API"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=kocluk_notification;Username=kemal;Password=kemal1234;"
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "no-reply@app.local",
    "FromName": "Kocluk"
  },
  "EmailLinks": {
    "VerifyEmailUrl": "https://localhost:5173/verify-email",
    "ResetPasswordUrl": "https://localhost:5173/reset-password",
    "ConfirmPasswordChangeUrl": "https://localhost:5173/confirm-password-change",
    "ConfirmEmailChangeUrl": "https://localhost:5173/confirm-email-change"
  }
}
