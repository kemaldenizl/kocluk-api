{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ApiGateway"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "security-auth": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "security-mfa": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/mfa/{**catch-all}" }
      },
      "security-users": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "security-memberships": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/memberships/{**catch-all}" }
      },
      "security-sessions": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/sessions/{**catch-all}" }
      },
      "security-roles": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },
      "security-permissions": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/permissions/{**catch-all}" }
      },
      "security-test": {
        "ClusterId": "security-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/test/{**catch-all}" }
      },
      "tenant-tenants": {
        "ClusterId": "tenant-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/tenants/{**catch-all}" }
      }
    },
    "Clusters": {
      "security-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5188/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      },
      "tenant-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5200/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      }
    }
  }
}
