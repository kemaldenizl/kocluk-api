# Copy to `.env` (same folder) before running docker compose:
#   cp deploy/.env.example deploy/.env
# These values are wired into the containers by deploy/docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_USER=kocluk
POSTGRES_PASSWORD=kocluk
POSTGRES_PORT=5432

# --- RabbitMQ ---
# guest is refused over the network, so a dedicated user is created instead.
RABBITMQ_USER=kocluk
RABBITMQ_PASSWORD=kocluk
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Redis ---
REDIS_PORT=6379

# --- JWT (Security service) ---
# MUST be at least 32 characters. Generate your own for anything shared.
JWT_SIGNING_KEY=super-long-development-signing-key-dummy-temp-devl-123456
JWT_ISSUER=SecurityService
JWT_AUDIENCE=SecurityService.Clients

# --- Seeded admin (development only) ---
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=DummyPw123!

# --- Notification / Resend email provider (optional in dev) ---
RESEND_API_KEY=

# --- Host port bindings ---
GATEWAY_PORT=8080
SECURITY_PORT=8081
TENANT_PORT=8082
NOTIFICATION_PORT=8083
